#!/usr/bin/env python3
"""Report on a replay written by incbench-history: soundness, precision and performance of each
mode's incremental compiles against the clean build of the same commit.

    incbench-history-report OUT [OUT2 ...] [--json]

Reads OUT/replay.json, OUT/commits.jsonl and OUT/work/steps.jsonl, writes OUT/report.md and prints
its path. A replay that is still running can be reported on: a truncated last line and a step
that lacks some of its lines are left out. --json also prints the summary numbers of each OUT to
stdout, for comparing two runs; the paths of the reports then go to stderr.
"""

import argparse
import json
import os
import sys
import time
from collections import Counter, OrderedDict
from itertools import combinations
from pathlib import Path
from statistics import median

FINDINGS = ("stale", "missed-error", "spurious-error")
VERDICTS = ("same", "noise", "compiler", "stale", "same-fail", "missed-error", "spurious-error")
LEVELS = ("raw", "pool", "locals", "typevars", "tasty")
CAP = 30
ZINC_TOTALS = ("compile", "zincCall")


# ---------------------------------------------------------------------------------------------
# Reading


def read_jsonl(path):
    """The lines of a file that parse as JSON objects, and how many did not."""
    rows, bad = [], 0
    if not path.exists():
        return rows, bad
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if isinstance(row, dict):
                rows.append(row)
            else:
                bad += 1
    return rows, bad


def parse_mode(spec):
    name, _, opts = spec.partition("=")
    return name, opts


class Step:
    def __init__(self, name, index):
        self.name = name
        self.index = index
        self.clean = None
        self.modes = {}
        self.resets = {}
        self.meta = None

    @property
    def number(self):
        return self.name.split("-", 1)[0]

    @property
    def sha(self):
        if self.meta and self.meta.get("commit"):
            return self.meta["commit"][:9]
        return self.name.split("-", 1)[1] if "-" in self.name else ""

    @property
    def subject(self):
        return self.meta.get("subject", "") if self.meta else ""

    @property
    def date(self):
        return (self.meta.get("date") or "")[:10] if self.meta else ""

    @property
    def clean_ok(self):
        return bool(self.clean.get("ok")) and isinstance(self.clean.get("result"), dict)

    def mode_ok(self, m):
        return bool(self.modes[m].get("ok")) and isinstance(self.modes[m].get("result"), dict)

    def files_changed(self):
        if self.meta and isinstance(self.meta.get("changed"), list):
            return len(self.meta["changed"])
        changed = [c for c in self.clean.get("changed", []) if "/src/" in c]
        return len(changed) if self.clean.get("changedCount", 0) <= len(self.clean.get("changed", [])) else None

    def source_count(self):
        """The sources of the build at this step: what the clean build's first cycles compiled."""
        if not self.clean_ok:
            return None
        runs = self.clean["result"].get("zincRuns")
        if not runs:
            return None
        total = 0
        for r in runs:
            cycles = r.get("cycles") or []
            if not cycles:
                return None
            total += cycles[0].get("sources", 0)
        return total or None


class Replay:
    def __init__(self, out):
        self.out = out
        try:
            self.info = json.loads((out / "replay.json").read_text())
        except (OSError, ValueError):
            self.info = {}
        commits, self.bad_commits = read_jsonl(out / "commits.jsonl")
        self.commits = {c.get("step"): c for c in commits}
        self.steps_file = out / "work" / "steps.jsonl"
        rows, self.bad_rows = read_jsonl(self.steps_file)

        specs = self.info.get("modes") or []
        self.mode_options = OrderedDict(parse_mode(s) for s in specs)
        seen = OrderedDict()
        for r in rows:
            m = r.get("mode")
            if m and m != "clean" and "verdict" in r:
                seen[m] = True
        self.modes = list(self.mode_options) or list(seen)
        for m in seen:
            if m not in self.modes:
                self.modes.append(m)
                self.mode_options[m] = "(not in replay.json)"

        steps = OrderedDict()
        for r in rows:
            name, mode = r.get("step"), r.get("mode")
            if name is None or mode is None:
                continue
            s = steps.setdefault(name, Step(name, r.get("index", 0)))
            if "reset" in r:
                s.resets[mode] = r["reset"]
            elif mode == "clean":
                s.clean = r
            elif "verdict" in r:
                s.modes[mode] = r
        for s in steps.values():
            s.meta = self.commits.get(s.name)
        complete = [s for s in steps.values() if s.clean is not None and all(m in s.modes for m in self.modes)]
        self.incomplete = [s.name for s in steps.values() if s not in complete]
        self.base = next((s for s in complete if s.name == "base" or s.index == 0), None)
        self.steps = [s for s in complete if s is not self.base]


# ---------------------------------------------------------------------------------------------
# Formatting


def esc(s):
    return str(s).replace("|", "\\|").replace("\n", " ").replace("\r", " ")


def trunc(s, n):
    s = str(s)
    return s if len(s) <= n else s[: n - 1].rstrip() + "…"


def code(s):
    return "`" + str(s).replace("`", "'") + "`"


def num(x, digits=0):
    if x is None:
        return "-"
    if digits == 0:
        return f"{int(round(x)):,}"
    return f"{x:,.{digits}f}"


def pct(a, b, digits=0):
    return "-" if not b else f"{100.0 * a / b:.{digits}f}%"


def ratio(a, b):
    return "-" if not b else f"{a / b:.2f}"


def secs(ms):
    return "-" if ms is None else f"{ms / 1000.0:,.1f}"


def med(xs):
    return median(xs) if xs else None


def plural(n, word, many=None):
    return f"{n:,} {word if n == 1 else (many or word + 's')}"


def table(headers, rows, right=(), cap=None, what="rows"):
    """A Markdown table; `right` are the indices of right-aligned columns."""
    if not rows:
        return []
    shown = rows if cap is None else rows[:cap]
    out = ["| " + " | ".join(headers) + " |",
           "|" + "|".join("---:" if i in right else "---" for i in range(len(headers))) + "|"]
    for r in shown:
        out.append("| " + " | ".join(esc(c) for c in r) + " |")
    if len(rows) > len(shown):
        out += ["", f"and {len(rows) - len(shown):,} more {what}."]
    return out


def step_label(s):
    return f"{s.number} `{s.sha}`"


def short_class(key):
    return key


# ---------------------------------------------------------------------------------------------
# Measures


def wall(row):
    return row["result"].get("wallMillis", 0)


def cycles(row):
    r = row.get("result")
    return r.get("rounds") if isinstance(r, dict) else None


def scalac_millis(result):
    phases = result.get("scalacPhases")
    if not phases:
        return None, None
    total = sum(p.get("millis", 0) for p in phases)
    xsbt = sum(p.get("millis", 0) for p in phases if str(p.get("phase", "")).startswith("xsbt-"))
    return total, xsbt


def zinc_own_millis(result):
    z = result.get("zinc")
    if not z:
        return None
    return sum(v for k, v in z.items() if k not in ZINC_TOTALS and isinstance(v, (int, float)))


def first_cycle_changes(row):
    """The module, cycle and API changes of the first cycle that reports any."""
    r = row.get("result")
    if not isinstance(r, dict):
        return None
    for run in r.get("zincRuns") or []:
        for c in run.get("cycles") or []:
            if c.get("changes"):
                return run.get("module"), c
    return None


def analyse(rp):
    """Every number the report states, as a JSON-serialisable summary."""
    modes, steps = rp.modes, rp.steps
    S = OrderedDict()
    S["out"] = str(rp.out)
    S["repo"] = Path(rp.info.get("repo", "")).name or None
    S["zincCommit"] = rp.info.get("zincCommit")
    S["modes"] = OrderedDict((m, rp.mode_options.get(m, "")) for m in modes)
    S["steps"] = OrderedDict(complete=len(steps), incomplete=len(rp.incomplete), unparsedLines=rp.bad_rows,
                             cleanFailed=sum(1 for s in steps if not s.clean_ok))
    S["base"] = OrderedDict((m, rp.base.modes[m].get("verdict")) for m in modes) if rp.base else None

    S["verdicts"] = OrderedDict((m, OrderedDict((v, 0) for v in VERDICTS)) for m in modes)
    S["findings"] = []
    for s in steps:
        for m in modes:
            v = s.modes[m].get("verdict", "?")
            S["verdicts"][m][v] = S["verdicts"][m].get(v, 0) + 1
            if v in FINDINGS:
                S["findings"].append(OrderedDict(step=s.name, mode=m, verdict=v, reset=s.resets.get(m)))
    S["stepsWithCompilerVerdict"] = sum(1 for s in steps if any(s.modes[m].get("verdict") == "compiler" for m in modes))
    S["stepsWithNoiseVerdict"] = sum(1 for s in steps if any(s.modes[m].get("verdict") == "noise" for m in modes))

    noise = OrderedDict((m, Counter()) for m in modes)
    compiler_classes = set()
    for s in steps:
        for m in modes:
            for d in s.modes[m].get("differences", []):
                if d.get("kind") == "noise":
                    noise[m][d.get("level") or "?"] += 1
                elif d.get("kind") == "compiler":
                    compiler_classes.add(d.get("class"))
    S["noiseByLevel"] = OrderedDict((m, OrderedDict(sorted(c.items()))) for m, c in noise.items())
    S["compilerClasses"] = len(compiler_classes)

    # Precision
    S["precision"] = OrderedDict()
    for m in modes:
        rows = [s for s in steps if s.clean_ok and s.mode_ok(m)]
        compiled = [s.modes[m].get("compiledCount", 0) for s in rows]
        necessary = [s.clean.get("necessaryCount", 0) for s in rows]
        ratios = [c / n for c, n in zip(compiled, necessary) if n > 0]
        counts = [s.source_count() for s in rows]
        full = None if any(c is None for c in counts) else sum(1 for c, n in zip(compiled, counts) if c >= n)
        S["precision"][m] = OrderedDict(
            steps=len(rows),
            compiledTotal=sum(compiled),
            compiledMedian=med(compiled),
            necessaryTotal=sum(necessary),
            ratioOverall=(sum(compiled) / sum(necessary)) if sum(necessary) else None,
            ratioMedian=med(ratios),
            stepsWithNecessary=len(ratios),
            cyclesTotal=sum(cycles(s.modes[m]) or 0 for s in rows),
            cyclesMedian=med([cycles(s.modes[m]) or 0 for s in rows]),
            classesRecompiled=sum(s.modes[m]["result"].get("recompiled", 0) for s in rows),
            fullRecompiles=full,
            stepsNecessaryNotCompiled=sum(1 for s in rows if s.modes[m].get("necessaryNotCompiled")),
        )

    S["precisionPairs"] = OrderedDict()
    S["performancePairs"] = OrderedDict()
    for a, b in combinations(modes, 2):
        rows = [s for s in steps if s.clean_ok and s.mode_ok(a) and s.mode_ok(b)]
        ca = [s.modes[a].get("compiledCount", 0) for s in rows]
        cb = [s.modes[b].get("compiledCount", 0) for s in rows]
        S["precisionPairs"][f"{a} vs {b}"] = OrderedDict([
            ("steps", len(rows)),
            ("differ", sum(1 for x, y in zip(ca, cb) if x != y)),
            (f"{a}Fewer", sum(1 for x, y in zip(ca, cb) if x < y)),
            (f"{a}FewerBy", sum(y - x for x, y in zip(ca, cb) if x < y)),
            (f"{b}Fewer", sum(1 for x, y in zip(ca, cb) if y < x)),
            (f"{b}FewerBy", sum(x - y for x, y in zip(ca, cb) if y < x)),
            (f"{a}Total", sum(ca)),
            (f"{b}Total", sum(cb)),
        ])
        wa = [wall(s.modes[a]) for s in rows]
        wb = [wall(s.modes[b]) for s in rows]
        diffs = [y - x for x, y in zip(wa, wb)]
        S["performancePairs"][f"{a} vs {b}"] = OrderedDict([
            ("steps", len(rows)),
            (f"{b}Minus{a.capitalize()}MedianMillis", med(diffs)),
            (f"{b}Minus{a.capitalize()}SumMillis", sum(diffs)),
            (f"{a}FasterBy10Percent", sum(1 for x, y in zip(wa, wb) if x < 0.9 * y)),
            (f"{b}FasterBy10Percent", sum(1 for x, y in zip(wa, wb) if y < 0.9 * x)),
        ])

    # Performance
    S["performance"] = OrderedDict()
    for m in modes:
        rows = [s for s in steps if s.clean_ok and s.mode_ok(m)]
        inc = [wall(s.modes[m]) for s in rows]
        cl = [wall(s.clean) for s in rows]
        per_step = [i / c for i, c in zip(inc, cl) if c > 0]
        prof = [s for s in rows if scalac_millis(s.modes[m]["result"])[0] is not None
                and zinc_own_millis(s.modes[m]["result"]) is not None]
        sc = sum(scalac_millis(s.modes[m]["result"])[0] for s in prof)
        xs = sum(scalac_millis(s.modes[m]["result"])[1] for s in prof)
        zo = sum(zinc_own_millis(s.modes[m]["result"]) for s in prof)
        pw = sum(wall(s.modes[m]) for s in prof)
        S["performance"][m] = OrderedDict(
            steps=len(rows),
            incSumMillis=sum(inc),
            incMedianMillis=med(inc),
            cleanSumMillis=sum(cl),
            cleanMedianMillis=med(cl),
            incOverClean=(sum(inc) / sum(cl)) if sum(cl) else None,
            incOverCleanMedianPerStep=med(per_step),
            profiledSteps=len(prof),
            profiledWallMillis=pw,
            scalacMillis=sc,
            scalacXsbtMillis=xs,
            zincOwnMillis=round(zo, 1),
            otherMillis=round(pw - sc - zo, 1),
        )
    return S


# ---------------------------------------------------------------------------------------------
# Sections


def bottom_line(rp, S):
    modes, n = rp.modes, len(rp.steps)
    if n == 0:
        return "No step is complete yet, so there is nothing to report."
    parts = [f"{plural(n, 'step')} replayed"]
    failed = S["steps"]["cleanFailed"]
    compared = n - failed
    if failed == n:
        return (f"{plural(n, 'step')} replayed, and the clean build failed at every one of them, so no incremental "
                "build was compared with a clean build and this run says nothing about soundness, precision or "
                "performance. The errors are listed under Soundness; when the initial build fails too, the "
                "export's classpath or options probably do not fit this part of the history.")
    if failed:
        parts.append(f"the clean build failed at {failed} of them, which leaves {compared} compared")
    per_mode = {m: sum(1 for f in S["findings"] if f["mode"] == m) for m in modes}
    if not S["findings"]:
        parts.append("no findings under " + ("either mode" if len(modes) == 2 else "any mode" if len(modes) > 1 else f"`{modes[0]}`"))
    else:
        parts.append("findings against the incremental compiler: " + ", ".join(f"{per_mode[m]} under `{m}`" for m in modes))
    parts.append(f"{plural(S['stepsWithCompilerVerdict'], 'step')} with compiler nondeterminism "
                 f"and {S['stepsWithNoiseVerdict']} with only noise")
    for key, p in S["precisionPairs"].items():
        a, b = key.split(" vs ")
        ta, tb = p[f"{a}Total"], p[f"{b}Total"]
        if ta and tb and ta != tb:
            lo, hi = (b, a) if tb < ta else (a, b)
            parts.append(f"`{lo}` compiled {100.0 * (max(ta, tb) - min(ta, tb)) / max(ta, tb):.1f}% fewer sources than `{hi}` over the history ({min(ta, tb):,} against {max(ta, tb):,})")
        elif ta == tb:
            parts.append(f"`{a}` and `{b}` compiled the same number of sources over the history ({ta:,})")
    for m in modes:
        p, q = S["precision"][m], S["performance"][m]
        if p["ratioOverall"] is not None and q["incOverClean"] is not None:
            parts.append(f"`{m}` compiled {p['ratioOverall']:.1f} times the necessary sources and took {100 * q['incOverClean']:.0f}% of the clean build time in total")
    base_bad = [m for m in modes if rp.base and rp.base.modes[m].get("verdict") != "same"]
    if base_bad:
        parts.append("the initial build's verdict is not `same` (see Soundness)")
    return "; ".join(parts)[0].upper() + "; ".join(parts)[1:] + "."


def header(rp, S):
    info, steps = rp.info, rp.steps
    L = [f"# Incremental compile replay: {S['repo'] or rp.out.name}", ""]
    start = (info.get("start") or "")[:9]
    last = steps[-1] if steps else None
    dated = [s.date for s in steps if s.date]
    rng = f"`{start}`..`{last.sha}`" if start and last else "unknown"
    L.append(f"- Repository: `{S['repo']}`, first-parent commits {rng}"
             + (f", committed {dated[0]} to {dated[-1]}" if dated else "")
             + (f"; the export (modules, classpaths, options) is of `{info['exportCommit'][:9]}`" if info.get("exportCommit") else "")
             + ".")
    line = f"- Steps: {len(steps)} complete"
    if rp.incomplete:
        line += f", {len(rp.incomplete)} in progress and left out ({', '.join(code(n) for n in rp.incomplete[:3])})"
    line += "; the number planned is not recorded in `replay.json`."
    if rp.bad_rows:
        line += f" {plural(rp.bad_rows, 'line')} of `steps.jsonl` did not parse (a line still being written) and {'was' if rp.bad_rows == 1 else 'were'} skipped."
    L.append(line)
    missing = [s.name for s in steps if not s.meta]
    if missing:
        L.append(f"- {plural(len(missing), 'step')} ({', '.join(code(n) for n in missing[:3])}) {'is' if len(missing) == 1 else 'are'} not in `commits.jsonl` yet, so {'its' if len(missing) == 1 else 'their'} subject, date and files changed are blank.")
    L.append(f"- Modules: {', '.join(code(m) for m in info.get('modules', [])) or 'unknown'}; Scala {info.get('scala', 'unknown')}.")
    L.append("- Modes: " + "; ".join(f"`{m}` ({rp.mode_options.get(m) or 'no options of its own'})" for m in rp.modes)
             + (f". Options of every mode and of the clean build: {', '.join(code(o) for o in info.get('incOptions', []))}." if info.get("incOptions") else "."))
    L.append(f"- Zinc: `{(info.get('zincCommit') or 'unknown')[:9]}`" + (f" in `{info['zinc']}`" if info.get("zinc") else "") + ".")
    when = f"- Started {info.get('started', 'unknown')}"
    if rp.steps_file.exists():
        when += "; `steps.jsonl` last written " + time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(rp.steps_file.stat().st_mtime))
    total = sum(s.meta.get("seconds", 0) for s in steps if s.meta)
    if total:
        when += f"; the steps took {total / 60:.1f} minutes"
    L.append(when + ".")
    L += ["", bottom_line(rp, S), ""]
    return L


def diff_list(rp, s, m, kinds, cap=15):
    """Lines for the differences of the given kinds at a step, with their evidence."""
    row = s.modes[m]
    diffs = [d for d in row.get("differences", []) if d.get("kind") in kinds]
    root = rp.out / "work" / "diffs" / s.name / m
    L = []
    for d in diffs[:cap]:
        key = d.get("class", "")
        line = f"  - `{key}`: {d.get('kind')}" + (f" at level {d['level']}" if d.get("level") else "")
        line += ", written by this step" if d.get("fresh") else ", not written by this step"
        if (root / (key + ".diff")).exists():
            line += f"; diff `work/diffs/{s.name}/{m}/{key}.diff`"
        elif (root / "inc" / key).exists() or (root / "clean" / key).exists():
            sides = [side for side in ("inc", "clean") if (root / side / key).exists()]
            line += f"; classfile kept for {' and '.join(sides)} only"
        L.append(line)
    if len(diffs) > cap:
        L.append(f"  - and {len(diffs) - cap:,} more.")
    return L, len(diffs)


def soundness(rp, S):
    modes, steps = rp.modes, rp.steps
    L = ["## Soundness", ""]
    used = [v for v in VERDICTS if any(S["verdicts"][m].get(v) for m in modes)]
    extra = [v for m in modes for v in S["verdicts"][m] if v not in VERDICTS]
    used += sorted(set(extra))
    L.append(f"Steps by verdict, over {plural(len(steps), 'step')}. Findings against the incremental compiler are `stale`, `missed-error` and `spurious-error`.")
    L.append("")
    L += table(["Mode"] + used + ["findings"],
               [[code(m)] + [S["verdicts"][m].get(v, 0) for v in used]
                + [sum(S["verdicts"][m].get(v, 0) for v in FINDINGS)] for m in modes],
               right=range(1, len(used) + 2))
    L.append("")

    # Base
    if rp.base:
        bad = [m for m in modes if rp.base.modes[m].get("verdict") != "same"]
        if not bad:
            L.append("The initial build (`base`) is `same` under every mode: each mode's own clean build equals the reference.")
        else:
            L.append("The initial build (`base`) is not `same`: " + ", ".join(f"`{m}` is `{rp.base.modes[m].get('verdict')}`" for m in bad) + ".")
            errs = rp.base.clean.get("errors") or next((rp.base.modes[m].get("errors") for m in bad if rp.base.modes[m].get("errors")), None)
            if errs:
                L.append(f"The first of its {len(errs)}{' or more' if len(errs) >= 20 else ''} compile errors: " + "; ".join(code(trunc(e, 120)) for e in list(OrderedDict.fromkeys(errs))[:3]) + ".")
            for m in bad:
                dl, n = diff_list(rp, rp.base, m, ("stale", "missing", "extra", "compiler", "noise"), cap=8)
                if n:
                    L.append(f"- `{m}`: {plural(n, 'difference')}")
                    L += dl
        L.append("")
    else:
        L += ["The initial build (`base`) is not in `steps.jsonl`.", ""]

    # Findings
    L += ["### Findings", ""]
    found = [(s, m) for s in steps for m in modes if s.modes[m].get("verdict") in FINDINGS]
    if not found:
        L += [f"None: no step is `stale`, `missed-error` or `spurious-error` under {'any mode' if len(modes) > 1 else 'the mode'}.", ""]
    by_step = OrderedDict()
    for s, m in found:
        by_step.setdefault(s.name, (s, []))[1].append(m)
    for s, ms in by_step.values():
        L += [f"#### {s.name}: " + ", ".join(f"{s.modes[m]['verdict']} under {m}" for m in ms), ""]
        L.append(f"Commit `{s.sha}`" + (f", {s.date}" if s.date else "") + (f": {esc(s.subject)}" if s.subject else "")
                 + f". {plural(s.files_changed() or 0, 'file')} changed, {s.clean.get('necessaryCount', 0)} necessary.")
        L.append("")
        for m in ms:
            row = s.modes[m]
            v = row["verdict"]
            L.append(f"- `{m}`: `{v}`; compiled {plural(row.get('compiledCount', 0), 'source')}"
                     + (f" in {plural(cycles(row), 'cycle')}" if cycles(row) is not None else "")
                     + f"; verdict after the reset to a clean build: {code(s.resets[m]) if m in s.resets else 'not recorded'}.")
            if v == "stale":
                dl, n = diff_list(rp, s, m, ("stale", "missing", "extra"))
                L.append(f"  - {plural(n, 'class', 'classes')} stale, missing or extra"
                         + (f" (of {row.get('differenceCount')} differences; the list in `steps.jsonl` is capped at 200)" if row.get("differenceCount", 0) > len(row.get("differences", [])) else "") + ":")
                L += ["  " + x for x in dl]
                other = Counter(d.get("kind") for d in row.get("differences", []) if d.get("kind") in ("compiler", "noise"))
                if other:
                    L.append("  - other differences at this step: " + ", ".join(f"{c} {k}" for k, c in sorted(other.items())) + ".")
            else:
                errs = (row.get("errors") if v == "spurious-error" else s.clean.get("errors")) or []
                side = "incremental" if v == "spurious-error" else "clean"
                L.append(f"  - the {side} build failed and the other did not; its errors" + (" (first 20)" if len(errs) >= 20 else "") + ":")
                L += [f"    - `{trunc(e, 200)}`" for e in errs[:10]]
                if len(errs) > 10:
                    L.append(f"    - and {len(errs) - 10} more.")
            nnc = row.get("necessaryNotCompiled") or []
            if nnc:
                L.append(f"  - necessary but not compiled ({len(nnc)}{' or more' if len(nnc) >= 200 else ''}): "
                         + ", ".join(code(x) for x in nnc[:8]) + (f" and {len(nnc) - 8} more" if len(nnc) > 8 else "") + ".")
            else:
                L.append("  - necessary but not compiled: none.")
            root = rp.out / "work" / "diffs" / s.name / m
            if root.is_dir():
                logs = sorted(p.name for p in root.glob("invalidation-*.log"))
                L.append(f"  - evidence: `work/diffs/{s.name}/{m}/` (`inc/` and `clean/` classfiles, `.class.diff` files"
                         + (", " + ", ".join(code(x) for x in logs) if logs else "") + ").")
            else:
                L.append(f"  - evidence: none under `work/diffs/{s.name}/{m}/`.")
        L.append("")

    # Compiler nondeterminism
    L += ["### Compiler nondeterminism", ""]
    groups = OrderedDict()
    for s in steps:
        for m in modes:
            for d in s.modes[m].get("differences", []):
                if d.get("kind") == "compiler":
                    g = groups.setdefault(d.get("class"), {"steps": OrderedDict(), "modes": OrderedDict()})
                    g["steps"][s.name] = s
                    g["modes"][m] = True
    if not groups:
        L += ["None: no class that a step wrote differs from the clean build beyond what the normalisation levels explain.", ""]
    else:
        L.append(f"{plural(len(groups), 'class', 'classes')} that an incremental compile wrote and that {'differs' if len(groups) == 1 else 'differ'} from the clean build's with no normalisation level to explain it, over {plural(S['stepsWithCompilerVerdict'], 'step')} with the verdict `compiler`. A class is listed once, however many steps and modes show it.")
        L.append("")
        rows = sorted(groups.items(), key=lambda kv: (-len(kv[1]["steps"]), kv[0]))
        L += table(["Class", "Steps", "Modes", "First step", "Evidence"],
                   [[code(k), len(g["steps"]), ", ".join(g["modes"]), step_label(next(iter(g["steps"].values()))),
                     evidence_path(rp, next(iter(g["steps"].values())), list(g["modes"]), k)] for k, g in rows],
                   right=(1,), cap=CAP, what="classes")
        L.append("")

    # Noise
    L += ["### Noise", ""]
    levels = Counter()
    per_mode = {m: Counter() for m in modes}
    classes = {}
    capped = 0
    for s in steps:
        for m in modes:
            row = s.modes[m]
            if row.get("differenceCount", 0) > len(row.get("differences", [])):
                capped += 1
            for d in row.get("differences", []):
                if d.get("kind") == "noise":
                    lv = d.get("level") or "?"
                    levels[lv] += 1
                    per_mode[m][lv] += 1
                    c = classes.setdefault(d.get("class"), {"n": 0, "steps": set(), "modes": OrderedDict(), "levels": set()})
                    c["n"] += 1
                    c["steps"].add(s.name)
                    c["modes"][m] = True
                    c["levels"].add(lv)
    if not levels:
        L += ["None: no difference was explained by a normalisation level.", ""]
    else:
        L.append(f"Differences that a normalisation level explains, counted once per class, step and mode ({sum(levels.values()):,} in all, over {len(classes):,} classes). A class is counted at the lowest level at which the two sides are equal.")
        L.append("")
        order = [l for l in LEVELS if l in levels] + sorted(l for l in levels if l not in LEVELS)
        L += table(["Level"] + [code(m) for m in modes] + ["Total"],
                   [[code(l)] + [per_mode[m][l] for m in modes] + [levels[l]] for l in order],
                   right=range(1, len(modes) + 2))
        L.append("")
        if capped:
            L += [f"{plural(capped, 'step-mode line')} had more differences than the 200 that `steps.jsonl` lists, so these counts are a lower bound.", ""]
        rows = sorted(classes.items(), key=lambda kv: (-len(kv[1]["steps"]), -kv[1]["n"], kv[0]))
        L += ["The most frequent classes:", ""]
        L += table(["Class", "Level", "Steps", "Modes"],
                   [[code(k), ", ".join(sorted(c["levels"])), len(c["steps"]), ", ".join(c["modes"])] for k, c in rows],
                   right=(2,), cap=15, what="classes")
        L.append("")

    # Clean failures
    L += ["### Steps where the clean build failed", ""]
    failed = [s for s in steps if not s.clean_ok]
    if not failed:
        L += ["None.", ""]
    else:
        L.append(f"{plural(len(failed), 'step')} of {len(steps)}. A step whose incremental builds fail too is `same-fail` and is not compared further. Grouped by the first error line of the clean build, shown with the next distinct ones (file name and message; warnings that the build's options make fatal are among them):")
        L.append("")
        groups = OrderedDict()
        for s in failed:
            errs = s.clean.get("errors") or ["(no error recorded)"]
            groups.setdefault(errs[0], []).append(s)

        def first_errors(s):
            distinct = list(OrderedDict.fromkeys(s.clean.get("errors") or ["(no error recorded)"]))
            return "; ".join(code(trunc(e, 90)) for e in distinct[:3])

        L += table(["First errors", "Steps", "First", "Last"],
                   [[first_errors(ss[0]), len(ss), step_label(ss[0]), step_label(ss[-1])] for e, ss in groups.items()],
                   right=(1,), cap=CAP, what="distinct errors")
        L.append("")
        odd = [(s, m) for s in failed for m in modes if s.modes[m].get("verdict") == "same-fail" and s.modes[m].get("compiledCount", 0) > 0]
        if odd:
            L += [f"In {len(set(s.name for s, _ in odd))} of these steps a failing incremental compile still recorded compiled sources (`compiledCount` above zero); they are not counted under Precision.", ""]
    return L


def evidence_path(rp, s, ms, key):
    for m in ms:
        if (rp.out / "work" / "diffs" / s.name / m / (key + ".diff")).exists():
            return f"`work/diffs/{s.name}/{m}/{key}.diff`"
    return "-"


def precision(rp, S):
    modes, steps = rp.modes, rp.steps
    L = ["## Precision", ""]
    eligible = [s for s in steps if s.clean_ok]
    if not eligible:
        return L + ["No step has a clean build that compiled, so there is no necessary set to compare with.", ""]
    L.append("Over the history steps where both the mode and the clean build compiled. \"Compiled\" is the number of distinct sources the incremental compile compiled; \"necessary\" is the number of sources that changed or whose clean classfiles changed since the previous step, a lower bound for any incremental compiler.")
    L.append("")
    P = S["precision"]
    rows = [
        ["Steps"] + [P[m]["steps"] for m in modes],
        ["Sources compiled, total"] + [num(P[m]["compiledTotal"]) for m in modes],
        ["Sources compiled, median per step"] + [num(P[m]["compiledMedian"], 1) for m in modes],
        ["Necessary, total"] + [num(P[m]["necessaryTotal"]) for m in modes],
        ["Compiled / necessary, overall"] + [num(P[m]["ratioOverall"], 2) for m in modes],
        ["Compiled / necessary, median per step"] + [num(P[m]["ratioMedian"], 2) for m in modes],
        ["Classes recompiled, total over cycles"] + [num(P[m]["classesRecompiled"]) for m in modes],
        ["Cycles, total"] + [num(P[m]["cyclesTotal"]) for m in modes],
        ["Cycles, median per step"] + [num(P[m]["cyclesMedian"], 1) for m in modes],
        ["Steps that compiled every source"] + [("unknown" if P[m]["fullRecompiles"] is None else P[m]["fullRecompiles"]) for m in modes],
        ["Steps with a necessary source not compiled"] + [P[m]["stepsNecessaryNotCompiled"] for m in modes],
    ]
    L += table(["", *[code(m) for m in modes]], rows, right=range(1, len(modes) + 1))
    L.append("")
    counts = [s.source_count() for s in eligible]
    if all(c is not None for c in counts):
        L.append(f"The build's source count is taken per step from the clean build's first cycle of each module ({f"{min(counts):,} sources throughout" if min(counts) == max(counts) else f"{min(counts):,} to {max(counts):,} sources over the history"}); a step compiled every source when its distinct count reaches it.")
    else:
        L.append("The build's source count cannot be derived: the clean lines carry no `zincRuns` (the replay ran without `--profile`), so full recompiles are not counted.")
    zero = sum(1 for s in eligible if s.clean.get("necessaryCount", 0) == 0)
    L.append(f"The median ratio is over the steps with a non-empty necessary set ({len(eligible) - zero} of {len(eligible)}).")
    nnc = [(s, m) for s in eligible for m in modes if s.mode_ok(m) and s.modes[m].get("necessaryNotCompiled")]
    if nnc:
        L.append("A necessary source that was not compiled, at a step whose verdict is not a finding, means its classfiles were equal to the clean build's anyway or differed only as noise: "
                 + ", ".join(f"{step_label(s)} under `{m}` ({len(s.modes[m]['necessaryNotCompiled'])}, {s.modes[m].get('verdict')})" for s, m in nnc[:10])
                 + (f" and {len(nnc) - 10} more" if len(nnc) > 10 else "") + ".")
    L.append("")

    for a, b in combinations(modes, 2):
        p = S["precisionPairs"][f"{a} vs {b}"]
        L += [f"### {a} against {b}", ""]
        rows = [s for s in eligible if s.mode_ok(a) and s.mode_ok(b)]
        L.append(f"Of {plural(p['steps'], 'step')} where both compiled, they compiled different numbers of sources in {p['differ']}: "
                 f"`{a}` fewer in {p[a + 'Fewer']} (by {p[a + 'FewerBy']:,} sources in total), `{b}` fewer in {p[b + 'Fewer']} (by {p[b + 'FewerBy']:,}). "
                 f"Totals: `{a}` {p[a + 'Total']:,}, `{b}` {p[b + 'Total']:,}"
                 + (f" ({100.0 * (p[b + 'Total'] - p[a + 'Total']) / p[a + 'Total']:+.1f}% relative to `{a}`)." if p[a + "Total"] else "."))
        L.append("")
        differ = [s for s in rows if s.modes[a].get("compiledCount", 0) != s.modes[b].get("compiledCount", 0)]
        differ.sort(key=lambda s: -abs(s.modes[a].get("compiledCount", 0) - s.modes[b].get("compiledCount", 0)))
        if differ:
            L += ["The largest differences:", ""]
            L += table(["Step", "Subject", "Necessary", f"{a} sources", f"{a} cycles", f"{b} sources", f"{b} cycles", f"{b} - {a}"],
                       [[step_label(s), trunc(s.subject, 50), s.clean.get("necessaryCount", 0),
                         s.modes[a].get("compiledCount", 0), cycles(s.modes[a]),
                         s.modes[b].get("compiledCount", 0), cycles(s.modes[b]),
                         f"{s.modes[b].get('compiledCount', 0) - s.modes[a].get('compiledCount', 0):+d}"] for s in differ],
                       right=range(2, 8), cap=15, what="steps")
            L.append("")

    # Over-compilation
    L += ["### Steps that compiled the most beyond the necessary", ""]

    def worst(s):
        return max((s.modes[m].get("compiledCount", 0) for m in modes if s.mode_ok(m)), default=0)

    def worst_mode(s):
        return max((m for m in modes if s.mode_ok(m)), key=lambda m: s.modes[m].get("compiledCount", 0), default=None)

    cand = [s for s in eligible if worst_mode(s) is not None and worst(s) > s.clean.get("necessaryCount", 0)]
    if not cand:
        return L + ["No step compiled more than the necessary set.", ""]
    by_ratio = sorted([s for s in cand if s.clean.get("necessaryCount", 0) > 0],
                      key=lambda s: -worst(s) / s.clean["necessaryCount"])[:10]
    by_excess = sorted(cand, key=lambda s: -(worst(s) - s.clean.get("necessaryCount", 0)))[:10]

    def rows_of(ss):
        out = []
        for s in ss:
            n = s.clean.get("necessaryCount", 0)
            cells = [step_label(s), trunc(s.subject, 45), s.source_count() or "-", n, worst(s) - n]
            for m in modes:
                c = s.modes[m].get("compiledCount", 0) if s.mode_ok(m) else None
                cells += ["-" if c is None else c, "-" if c is None or not n else f"{c / n:.1f}"]
            out.append(cells)
        return out

    heads = ["Step", "Subject", "Sources", "Necessary", "Excess"] + [h for m in modes for h in (f"{m}", f"{m} ratio")]
    right = range(2, 5 + 2 * len(modes))
    L += ["By the ratio of compiled to necessary. The mode that compiled more decides the rank and the excess; Sources is the size of the build; steps with an empty necessary set are left out:", ""]
    L += table(heads, rows_of(by_ratio), right=right) or ["None.", ""]
    L.append("")
    if {s.name for s in by_excess} == {s.name for s in by_ratio}:
        L += ["The steps with the most sources compiled beyond the necessary (the Excess column) are the same ones.", ""]
    else:
        L += ["By the number of sources compiled beyond the necessary:", ""]
        L += table(heads, rows_of(by_excess), right=right)
        L.append("")

    union = list(OrderedDict((s.name, s) for s in by_ratio + by_excess).values())
    notes = []
    for s in union:
        m = worst_mode(s)
        fc = first_cycle_changes(s.modes[m])
        if not fc:
            continue
        module, c = fc
        ch = c["changes"]
        items = []
        for x in ch[:3]:
            names = x.get("names") or []
            more = (x.get("namesTotal") or len(names)) - min(len(names), 4)
            desc = ", ".join(names[:4]) + (f" and {more} more" if more > 0 else "")
            reason = str(x.get("reason", "")).rstrip(".")
            items.append(f"`{x.get('class')}` ({reason}" + (f": `{desc}`" if desc else "") + ")")
        total = c.get("apiChanges", len(ch))
        notes.append(f"- {step_label(s)} under `{m}`: cycle {c.get('cycle')} of `{module}` compiled {plural(c.get('sources', 0), 'source')} and reported {plural(total, 'API change')}: "
                     + "; ".join(items) + (f"; and {total - 3} more" if total > 3 else "") + ".")
    if notes:
        L += ["What the first cycle with API changes reported at those steps, under the mode that compiled more (the changes that started the invalidation):", ""]
        L += notes + [""]
    else:
        L += ["The lines carry no `zincRuns`, so the API changes behind these steps are not known.", ""]
    return L


def performance(rp, S):
    modes, steps = rp.modes, rp.steps
    L = ["## Performance", ""]
    L.append("These timings come from a machine that was running other work. Each step ran once. The modes ran one after the other in the same JVM, in an order that rotates from step to step, and the clean build ran after them. Read differences of a few percent as noise.")
    L.append("")
    Q = S["performance"]
    if not any(Q[m]["steps"] for m in modes):
        return L + ["No step has both an incremental and a clean build that compiled, so there are no timings to compare.", ""]
    L.append("Wall time of the incremental compile (`wallMillis`) over the history steps where both the mode and the clean build compiled, against the clean build of the same steps.")
    L.append("")
    rows = [
        ["Steps"] + [Q[m]["steps"] for m in modes],
        ["Incremental, sum (s)"] + [secs(Q[m]["incSumMillis"]) for m in modes],
        ["Incremental, median (ms)"] + [num(Q[m]["incMedianMillis"]) for m in modes],
        ["Clean, sum (s)"] + [secs(Q[m]["cleanSumMillis"]) for m in modes],
        ["Clean, median (ms)"] + [num(Q[m]["cleanMedianMillis"]) for m in modes],
        ["Incremental / clean, of the sums"] + [pct(Q[m]["incSumMillis"], Q[m]["cleanSumMillis"], 1) for m in modes],
        ["Incremental / clean, median per step"] + ["-" if Q[m]["incOverCleanMedianPerStep"] is None else f"{100 * Q[m]['incOverCleanMedianPerStep']:.1f}%" for m in modes],
    ]
    L += table(["", *[code(m) for m in modes]], rows, right=range(1, len(modes) + 1))
    L.append("")

    L += ["### Where the incremental time went", ""]
    if not any(Q[m]["profiledSteps"] for m in modes):
        L += ["The lines carry no `scalacPhases` or `zinc` timings (the replay ran without `--profile`).", ""]
    else:
        rows = [
            ["Profiled steps"] + [Q[m]["profiledSteps"] for m in modes],
            ["Wall, sum (s)"] + [secs(Q[m]["profiledWallMillis"]) for m in modes],
            ["scalac phases (s)"] + [f"{secs(Q[m]['scalacMillis'])} ({pct(Q[m]['scalacMillis'], Q[m]['profiledWallMillis'])})" for m in modes],
            ["of which Zinc's phases in scalac, `xsbt-*` (s)"] + [f"{secs(Q[m]['scalacXsbtMillis'])} ({pct(Q[m]['scalacXsbtMillis'], Q[m]['profiledWallMillis'])})" for m in modes],
            ["Zinc's own (s)"] + [f"{secs(Q[m]['zincOwnMillis'])} ({pct(Q[m]['zincOwnMillis'], Q[m]['profiledWallMillis'])})" for m in modes],
            ["Unattributed (s)"] + [f"{secs(Q[m]['otherMillis'])} ({pct(Q[m]['otherMillis'], Q[m]['profiledWallMillis'])})" for m in modes],
        ]
        L += table(["", *[code(m) for m in modes]], rows, right=range(1, len(modes) + 1))
        L.append("")
        L.append("How this is computed: scalac is the sum of `scalacPhases` millis; Zinc's own is the sum of every entry of `zinc` except `compile` (which is the scalac run, already counted through its phases) and `zincCall` (the total of the others), so it includes `analysisWrite`, which falls outside `zincCall`; unattributed is wall time less both, that is the part of `compile` outside any phase and the harness around the Zinc call. Percentages are of the wall time.")
        L.append("")
        parts = OrderedDict()
        for m in modes:
            for s in steps:
                if s.clean_ok and s.mode_ok(m):
                    for k, v in (s.modes[m]["result"].get("zinc") or {}).items():
                        if k not in ZINC_TOTALS and isinstance(v, (int, float)):
                            parts.setdefault(k, {}).setdefault(m, 0.0)
                            parts[k][m] += v
        if parts:
            keys = sorted(parts, key=lambda k: -max(parts[k].values()))
            L += ["Zinc's own time by part, summed over the steps (s):", ""]
            L += table(["Part", *[code(m) for m in modes]],
                       [[code(k)] + [f"{parts[k].get(m, 0) / 1000:.2f}" for m in modes] for k in keys],
                       right=range(1, len(modes) + 1))
            L.append("")

    for a, b in combinations(modes, 2):
        p = S["performancePairs"][f"{a} vs {b}"]
        if not p["steps"]:
            continue
        ka = f"{b}Minus{a.capitalize()}"
        L += [f"### {a} against {b}, step by step", ""]
        sa, sb = Q[a]["incSumMillis"], Q[b]["incSumMillis"]
        L.append(f"Over {plural(p['steps'], 'step')} where both compiled, the difference `{b}` minus `{a}` in wall time has median {num(p[ka + 'MedianMillis'])} ms and sum {num(p[ka + 'SumMillis'])} ms"
                 + (f" ({pct(p[ka + 'SumMillis'], sa, 1)} of `{a}`'s total)" if sa and Q[a]["steps"] == p["steps"] else "")
                 + f". `{a}` was faster by more than 10% in {p[a + 'FasterBy10Percent']} steps and `{b}` in {p[b + 'FasterBy10Percent']} (one is faster by more than 10% when its time is under 0.9 of the other's).")
        L.append("")
    return L


def steps_table(rp):
    modes, steps = rp.modes, rp.steps
    L = ["## Steps", ""]
    if not steps:
        return L + ["No complete step.", ""]
    L.append("One row per history step. Per mode: verdict, distinct sources compiled, cycles, wall time in ms. A dash is a build that failed.")
    L.append("")
    heads = ["Step", "SHA", "Date", "Subject", "Files", "Nec."]
    for m in modes:
        heads += [m, "src", "cyc", "ms"]
    heads.append("clean ms")
    rows = []
    for s in steps:
        fc = s.files_changed()
        r = [s.number, code(s.sha), s.date, trunc(s.subject, 44), "-" if fc is None else fc,
             s.clean.get("necessaryCount", 0) if s.clean_ok else "-"]
        for m in modes:
            row = s.modes[m]
            ok = s.mode_ok(m)
            r += [row.get("verdict", "?"), row.get("compiledCount", 0), cycles(row) if ok else "-", num(wall(row)) if ok else "-"]
        r.append(num(wall(s.clean)) if s.clean_ok else "-")
        rows.append(r)
    right = [4, 5] + [i for k in range(len(modes)) for i in (7 + 4 * k, 8 + 4 * k, 9 + 4 * k)] + [6 + 4 * len(modes)]
    L += table(heads, rows, right=right)
    L.append("")
    return L


def how_to_read():
    return [
        "## How to read this",
        "",
        "- A step is a first-parent commit that changes a source of the exported modules. Each mode compiles it incrementally from the previous step's state, and a separate copy is built from scratch; a mode's verdict compares its classfiles with that clean build's.",
        "- `same`: every classfile is byte-identical. `noise`: every difference disappears under a normalisation level. `compiler`: an unexplained difference, all in classes this step's compile wrote, so the compiler's output depended on what else was in its batch. `stale`: an unexplained difference in a class this step did not write, or a missing or extra classfile: undercompilation.",
        "- `same-fail`: both builds failed. `missed-error`: the clean build failed and the incremental one did not. `spurious-error`: the reverse. The findings against the incremental compiler are `stale`, `missed-error` and `spurious-error`; after one, the mode is reset to a clean build, and the reset verdict is that build's.",
        "- Levels, each ignoring more than the one before: `raw` (nothing), `pool` (constant-pool order), `locals` (names of local variables), `typevars` (names of type variables in generic signatures), `tasty` (the TASTy UUID, when the TASTy files differ only in their header or positions). A noise difference carries the lowest level that makes the two sides equal.",
        "- A difference is fresh when this step's incremental compile wrote the class, and carried when an earlier step already reported it and neither side has changed since. Carried differences are not counted again and do not affect the verdict.",
        "- Necessary: the sources the commit changed plus the sources whose clean classfiles differ from the previous step's clean build. A sound incremental compile has to produce those classfiles, so compiled / necessary is 1.0 at best. It is a lower bound: the dependencies that have to be rechecked to know that nothing else changed are not in it.",
        "- Compiled is distinct sources, so a source compiled in two cycles counts once. Cycles is the number of compile rounds over all modules.",
        "- The initial build `base` is each mode's own clean build of the starting commit; it is checked but not counted.",
        "",
    ]


def render(rp, S):
    L = header(rp, S)
    if rp.steps or rp.base:
        L += soundness(rp, S)
    if rp.steps:
        L += precision(rp, S) + performance(rp, S) + steps_table(rp)
    L += how_to_read()
    return "\n".join(L).rstrip("\n") + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("out", type=Path, nargs="+", help="a directory written by incbench-history")
    ap.add_argument("--json", action="store_true", help="print the summary numbers as JSON to stdout")
    a = ap.parse_args()
    summaries, status = [], 0
    for out in a.out:
        if not (out / "work" / "steps.jsonl").exists() and not (out / "replay.json").exists():
            print(f"{out}: neither replay.json nor work/steps.jsonl", file=sys.stderr)
            status = 1
            continue
        rp = Replay(out)
        S = analyse(rp)
        report = out / "report.md"
        tmp = out / f".report.md.{os.getpid()}"
        tmp.write_text(render(rp, S), encoding="utf-8")
        os.replace(tmp, report)
        print(report, file=sys.stderr if a.json else sys.stdout)
        summaries.append(S)
    if a.json:
        json.dump(summaries[0] if len(a.out) == 1 and summaries else summaries, sys.stdout, indent=2)
        print()
    return status


if __name__ == "__main__":
    sys.exit(main())
